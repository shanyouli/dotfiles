{
  pkgs,
  lib,
  config,
  my,
  ...
}:
with lib;
with my;
let
  cfm = config.modules;
  cfp = cfm.dev;
  cfg = cfp.manager;
  cfbin = "${cfg.package}/bin/mise";

  # mise 默认会在激活 shell、命令未找到等场景自动安装工具，
  # 这里统一关闭，只写配置，安装动作交给用户显式执行 `mise install`。
  autoInstallSettings = [
    "auto_install"
    "exec_auto_install"
    "not_found_auto_install"
  ];

  # tools 的值支持：版本字符串、版本列表（取第一项）、bool/null（仅声明，不写版本）
  # 若 global 中显式指定了默认版本，则优先使用它。
  toolVersion =
    name: value:
    let
      defaultVersion = cfg.global.${name} or "";
    in
    if defaultVersion != "" then
      defaultVersion
    else if builtins.isString value then
      value
    else if builtins.isList value then
      let
        vers = filter builtins.isString value;
      in
      if vers == [ ] then "" else builtins.head vers
    else
      "";

  # 生成 nu 字符串字面量
  nuStr = s: if hasInfix "\"" s then "'${s}'" else "\"${s}\"";

  # 生成 mise 的 dotted key，带特殊字符的工具名需要按 TOML 规则加引号
  toolKey =
    name: if builtins.match "[A-Za-z0-9_-]+" name != null then "tools.${name}" else "tools.\"${name}\"";

  tools = filterAttrs (
    _: v:
    !(elem v [
      null
      false
    ])
  ) cfp.lang;

  settingsText = concatMapStrings (s: ''
    ^${cfbin} settings set ${s} false | ignore
  '') autoInstallSettings;

  toolText =
    name: value:
    let
      version = toolVersion name value;
    in
    if version == "" then
      ''
        log debug $"mise: ${name} 未指定版本，跳过全局配置写入"
      ''
    else
      ''
        do {
          let mise_key = ${nuStr (toolKey name)}
          let mise_want = ${nuStr version}
          let mise_cur = (do -i { ^${cfbin} config get --global $mise_key } | complete | get stdout | str trim)
          if $mise_cur != $mise_want {
            log debug $"mise: 写入全局配置 ($mise_key) -> ($mise_want)，需要时请执行 mise install"
            ^${cfbin} config set --global $mise_key $mise_want | ignore
          }
        }
      '';

  toolsText = concatStringsSep "\n" (mapAttrsToList toolText tools);
in
{
  options.modules.dev.manager = with types; {
    enable = mkBoolOpt' true "是否使用 mise 管理开发语言版本";
    global = mkOption {
      description = "各工具写入 mise 全局配置时的默认版本";
      type = attrsOf str;
      default = { };
    };
    package = mkPackageOption pkgs "mise" { };
    text = mkOpt' lines "" "init mise script";
    prevInit = mkOpt' lines "" "prev mise env";
    extInit = mkOpt' lines "" "extra mise Init";
  };
  config = mkIf cfg.enable {
    home = {
      packages = [ cfg.package ];
      programs.bash.initExtra = ''
        eval "$(mise activate bash)"
      '';
    };
    modules = {
      # 只写全局配置，不安装；安装交给用户执行 `mise install`
      dev.manager.text = ''
        ${cfg.prevInit}
        $env.MISE_CACHE_DIR = "${config.home.cacheDir}/mise"

        ${settingsText}
        ${toolsText}
        ${cfg.extInit}
      '';
      shell = {
        env.MISE_CACHE_DIR = "$XDG_CACHE_HOME/mise";
        zsh.rcInit = "_cache -v ${cfg.package.version} mise activate zsh";
        direnv.stdlib.mise = optionalNull cfm.shell.direnv.enable pkgs.writeScript "use_mise" ''
          #!/usr/bin/env sh
          ### Do not edit. This was autogenerated by 'mise direnv' ###
          use_mise() {
            direnv_load mise direnv exec
          }
        '';
        nushell.cacheCmd = [ "${cfbin} activate nu" ];
        fish.rcInit = "_cache -v${cfg.package.version} mise activate fish";
      };
    };
    my.user.init.init-dev = cfg.text;
  };
}
